#!/bin/bash
set -euo pipefail
pkill -x mpv || true
dir=$(mktemp -d)
trap 'rm -r "$dir"' EXIT
cat > "$dir/wait.lua" <<'EOF'
local utils = require "mp.utils"
local manifest = mp.get_opt("wait-manifest") or ""
local sizes, timer, overlay

local function clock(t)
  return string.format("%d:%05.2f", math.floor(t / 60), t % 60)
end

local function scrub()
  local d = mp.get_property_number("duration")
  local t = mp.get_property_number("time-pos")
  if not d or not t or mp.get_property_bool("current-tracks/video/image", true) then
    mp.set_property("user-data/scrub", "")
    return
  end
  local n = math.floor(30 * t / d + 0.5)
  local frame = mp.get_property_number("estimated-frame-number")
  local frames = mp.get_property_number("estimated-frame-count")
  mp.set_property("user-data/scrub", string.format("  %s %s [%s%s] %s%s",
    mp.get_property_bool("pause") and "||" or "> ", clock(t), string.rep("#", n), string.rep("-", 30 - n), clock(d),
    (frame and frames) and string.format("  frame %d/%d", frame + 1, frames) or ""))
end

mp.set_property("user-data/scrub", "")
mp.observe_property("time-pos", nil, scrub)
mp.observe_property("pause", nil, scrub)

local function exists(p)
  local f = io.open(p, "rb")
  if f then f:close() end
  return f ~= nil
end

local function read_sizes()
  local t = {}
  for line in io.lines(manifest) do
    local n, p = line:match("^(%d+) (.+)$")
    t[p] = tonumber(n)
  end
  return t
end

local function stop()
  if timer then timer:kill() timer = nil end
  if overlay then overlay:remove() end
end

mp.add_hook("on_load", 50, function()
  stop()
  if manifest == "" then return end
  local path = mp.get_property("stream-open-filename")
  if exists(path) then return end
  sizes = sizes or read_sizes()
  mp.set_property("stream-open-filename", "av://lavfi:color=c=0x101418:s=1280x720:r=4")
  local pos = mp.get_property_number("playlist-pos")
  local name = path:match("[^/]+$"):gsub("^%d+%-", "", 1):gsub("\\", "\\\239\187\191"):gsub("{", "\\{")
  overlay = overlay or mp.create_osd_overlay("ass-events")
  overlay.res_x, overlay.res_y = 1280, 720
  local function draw()
    local part = utils.file_info(path .. ".part")
    local pct = part and math.floor(part.size * 100 / sizes[path]) or 0
    overlay.data = string.format("{\\an5\\pos(640,330)\\fs44\\1c&HDBD5D1&}%s\\N{\\fs96}%d%%", name, pct)
    overlay:update()
  end
  draw()
  timer = mp.add_periodic_timer(0.25, function()
    if not exists(path) then return draw() end
    stop()
    if mp.get_property_number("playlist-pos") == pos then
      mp.commandv("playlist-play-index", tostring(pos))
    end
  end)
end)
EOF
WAYLAND_DISPLAY=wayland-0 XDG_RUNTIME_DIR=/run/user/0 mpv --vo=wlshm --ao=alsa --no-input-default-bindings \
  --input-conf=<(printf '%s\n' 'SPACE playlist-next' 'n playlist-next' 'p playlist-prev' 'q quit' 'UP add ao-volume 5' 'DOWN add ao-volume -5' 'm cycle ao-mute' 'k cycle pause' 'LEFT seek -2 exact' 'RIGHT seek 2 exact' ', frame-back-step' '. frame-step') \
  --script="$dir/wait.lua" --script-opts="wait-manifest=${WAIT_MANIFEST:-}" \
  --loop-file=inf --image-display-duration=inf --osd-level=0 --msg-level=all=error,statusline=status \
  --term-status-msg='${playlist-pos-1}/${playlist-count} ${filename}${?ao-volume:  vol ${ao-volume}}${?ao-mute==yes: muted}${user-data/scrub}' "$@"
